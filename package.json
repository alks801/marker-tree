{
  "name": "marker-tree",
  "version": "0.1.0",
  "description": "The library for marking all needed DOM elements for e2e testing. It automatically creates selector and key from semantic MarkerTree that being used both in the project and your e2e solution.",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs",
    "build:esm": "tsc",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run lint && npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alks801/marker-tree.git"
  },
  "keywords": [
    "e2e",
    "marker",
    "tree",
    "selector",
    "testing",
    "data-test",
    "data-testid",
    "cypress",
    "playwright"
  ],
  "author": "Aleksandr Denisevich",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/alks801/marker-tree/issues"
  },
  "homepage": "https://github.com/alks801/marker-tree#readme",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.7"
  }
}
